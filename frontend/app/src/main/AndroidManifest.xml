<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        A TV has no touchscreen and no telephony. Declaring this keeps the app installable
        on Android TV devices, which would otherwise be filtered out by the implied
        touchscreen requirement.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:name=".HomeCenterApplication"
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeCenter"
        android:usesCleartextTraffic="true"
        tools:ignore="DataExtractionRules">

        <!--
            The server runs over plain HTTP on the home network (see the README), so
            cleartext has to stay allowed until the backend gets HTTPS.

            allowBackup="false" already switches backup off on every version this app runs
            on, which is why there are no backup or data-extraction rule files: the token
            and the resume positions belong to this television and should not travel to
            another one.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.HomeCenter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER is what puts the app on the Android TV home row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
